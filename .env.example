# Copy this file to .env and fill in real values before running `docker compose up`.
# .env is gitignored — never commit real secrets.

# MySQL (used by the mysql and backend services)
DB_NAME=taskmanager
DB_USERNAME=taskmanager
DB_PASSWORD=taskmanager
DB_ROOT_PASSWORD=root
DB_HOST_PORT=3307

# JWT (used by the backend service)
JWT_SECRET=change-this-super-secret-key-for-jwt-signing-minimum-32-chars
JWT_EXPIRATION_MS=86400000

# Ports exposed on the host
SERVER_PORT=8081
FRONTEND_PORT=5173
