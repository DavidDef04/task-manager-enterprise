# Copy this file to .env and fill in real values for local (non-Docker) development.
# .env is gitignored — never commit real secrets.

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=taskmanager
DB_USERNAME=taskmanager
DB_PASSWORD=taskmanager

# JWT
JWT_SECRET=change-this-super-secret-key-for-jwt-signing-minimum-32-chars
JWT_EXPIRATION_MS=86400000

# Server
SERVER_PORT=8081

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173
